{
    "name": "thewpsquad/freemius-wp-rest",
    "description": "Reusable WP REST API proxy routes for the Freemius WordPress SDK — account, license, affiliate, pricing.",
    "type": "library",
    "license": "GPL-3.0-only",
    "authors": [
        {
            "name": "The WP Squad",
            "email": "support@squadmodules.com",
            "homepage": "https://squadmodules.com"
        }
    ],
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "brain/monkey": "^2.6",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "mockery/mockery": "^1.6",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "phpstan/phpstan": "^1.10",
        "phpunit/phpunit": "^9.6 || ^10.0 || ^11.0",
        "szepeviktor/phpstan-wordpress": "^1.3",
        "wp-coding-standards/wpcs": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "TheWPSquad\\FreemiusRest\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TheWPSquad\\FreemiusRest\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test":    "phpunit --testdox",
        "phpstan": "phpstan analyse --memory-limit=256M",
        "phpcs":   "phpcs"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    }
}
